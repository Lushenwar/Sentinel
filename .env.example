# Required
ANTHROPIC_API_KEY=sk-ant-...
# Required for local (non-Docker) runs; docker-compose provides its own
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel
# Optional — Slack diagnostic cards are skipped if unset
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional — docker-compose Postgres password (defaults to "sentinel")
POSTGRES_PASSWORD=sentinel
ANTHROPIC_WORKSPACE_ID=   # only needed if the key is not workspace-scoped
# Recommended — shared secret: core rejects /alert requests without a matching HMAC signature, and the
# sandbox senders sign with it. Unset = unsigned alerts accepted (local dev). e.g. `openssl rand -hex 32`
SENTINEL_ALERT_SECRET=
# Optional — comma-separated dashboard origins allowed by CORS (default http://localhost:3000)
SENTINEL_CORS_ORIGINS=
